# Keep the build context small and deterministic. README.md is re-included
# because pyproject's `readme = "README.md"` is read during the wheel build.
.git
.github
.gitignore
**/__pycache__
*.py[cod]
.venv
venv
env
.env
.env.*
.mypy_cache
.ruff_cache
.pytest_cache
.coverage*
htmlcov
dist
build
*.egg-info
tests
demo
examples
_resources
.DS_Store
*.md
!README.md
